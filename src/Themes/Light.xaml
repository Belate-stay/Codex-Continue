<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Modern flat palette: cool gray canvas, pure-white cards, one confident blue.
         Hierarchy lives in surface contrast + hairlines + type scale — no embossing. -->
    <Color x:Key="Canvas">#F6F7F9</Color>
    <Color x:Key="Well">#FFFFFF</Color>
    <Color x:Key="Pill">#FFFFFF</Color>
    <Color x:Key="Hairline">#E7E9EE</Color>
    <Color x:Key="BorderHover">#D4D9E0</Color>
    <Color x:Key="FocusRing">#2E3D6FF5</Color>
    <Color x:Key="SurfaceHover">#F1F3F6</Color>
    <Color x:Key="SurfacePressed">#E8EBF0</Color>
    <Color x:Key="TextPrimary">#1C1F26</Color>
    <Color x:Key="TextSecondary">#69707D</Color>
    <Color x:Key="TextTertiary">#9AA1AE</Color>
    <Color x:Key="TextDisabled">#B8BEC8</Color>
    <Color x:Key="Accent">#3D6FF5</Color>
    <Color x:Key="AccentHover">#5580F7</Color>
    <Color x:Key="AccentPressed">#2F5CD6</Color>
    <Color x:Key="AccentText">#FFFFFF</Color>
    <Color x:Key="ModeSelected">#3563D9</Color>
    <Color x:Key="QuotaBlue">#3D6FF5</Color>
    <Color x:Key="QuotaYellow">#F5A623</Color>
    <Color x:Key="QuotaRed">#F04438</Color>
    <Color x:Key="QuotaTrail">#A99ACF</Color>
    <Color x:Key="Ok">#16A34A</Color>
    <Color x:Key="Err">#E5484D</Color>
    <Color x:Key="ErrPressed">#C93A3E</Color>
    <Color x:Key="Track">#EDEFF3</Color>
    <Color x:Key="CaptionHover">#EEF1F4</Color>
    <Color x:Key="CaptionCloseHover">#C42B1C</Color>
    <Color x:Key="NeuDark">#D6D3E0</Color>
    <Color x:Key="NeuLight">#FFFFFF</Color>
    <Color x:Key="SoftShadow">#14000000</Color>
    <Color x:Key="Scrim">#000000</Color>
    <Color x:Key="OkBg">#E7F6EC</Color>
    <Color x:Key="SelectBg">#E8EFFF</Color>
    <!-- keycap: quiet flat face; hover/press = tint veil (dark in light theme) -->
    <Color x:Key="KeycapFace">#F4F5F6</Color>
    <Color x:Key="KeycapHover">#0A000000</Color>
    <Color x:Key="KeycapPress">#14000000</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource Canvas}"/>
    <SolidColorBrush x:Key="WellBrush" Color="{StaticResource Well}"/>
    <SolidColorBrush x:Key="PillBrush" Color="{StaticResource Pill}"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource Hairline}"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHover}"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRing}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHover}"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressed}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabled}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentText}"/>
    <SolidColorBrush x:Key="ModeSelectedBrush" Color="{StaticResource ModeSelected}"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentOutlineBrush" Color="{StaticResource ModeSelected}"/>
    <SolidColorBrush x:Key="ButtonSurfaceBrush" Color="{StaticResource SelectBg}"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource SurfaceHover}"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="{StaticResource SurfacePressed}"/>
    <SolidColorBrush x:Key="LogAccentBrush" Color="{StaticResource QuotaBlue}"/>
    <SolidColorBrush x:Key="QuotaBlueBrush" Color="{StaticResource QuotaBlue}"/>
    <SolidColorBrush x:Key="QuotaYellowBrush" Color="{StaticResource QuotaYellow}"/>
    <SolidColorBrush x:Key="QuotaRedBrush" Color="{StaticResource QuotaRed}"/>
    <SolidColorBrush x:Key="QuotaTrailBrush" Color="{StaticResource QuotaTrail}"/>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource Ok}"/>
    <SolidColorBrush x:Key="ErrBrush" Color="{StaticResource Err}"/>
    <SolidColorBrush x:Key="ErrPressedBrush" Color="{StaticResource ErrPressed}"/>
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource Track}"/>
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="{StaticResource CaptionHover}"/>
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="{StaticResource CaptionCloseHover}"/>
    <SolidColorBrush x:Key="NeuDarkBrush" Color="{StaticResource NeuDark}"/>
    <SolidColorBrush x:Key="NeuLightBrush" Color="{StaticResource NeuLight}"/>
    <SolidColorBrush x:Key="SoftShadowBrush" Color="{StaticResource SoftShadow}"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource Scrim}"/>
    <SolidColorBrush x:Key="OkBgBrush" Color="{StaticResource OkBg}"/>
    <SolidColorBrush x:Key="SelectBgBrush" Color="{StaticResource SelectBg}"/>
    <SolidColorBrush x:Key="KeycapFaceBrush" Color="{StaticResource KeycapFace}"/>
    <SolidColorBrush x:Key="KeycapHoverBrush" Color="{StaticResource KeycapHover}"/>
    <SolidColorBrush x:Key="KeycapPressBrush" Color="{StaticResource KeycapPress}"/>
</ResourceDictionary>
